{
  "name": "shelf-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "shelf": "bun packages/cli/src/main.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p packages/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "build:all": "bun scripts/build-all.ts",
    "pack:npm": "bun scripts/pack-npm.ts",
    "dev": "bun scripts/dev.ts",
    "demo": "bun scripts/demo/seed.ts",
    "demo:site": "bun scripts/site/demo/build.ts",
    "demo:site:verify": "bun scripts/site/demo/verify.ts --build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@shelf/core": "workspace:*",
    "@shelf/server": "workspace:*",
    "@types/bun": "1.4.2",
    "bun-plugin-tailwind": "0.1.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
