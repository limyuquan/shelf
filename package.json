{
  "name": "shelf-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "shelf": "bun packages/cli/src/main.ts",
    "build": "bun build --compile --minify --bytecode packages/cli/src/main.ts --outfile dist/shelf",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
